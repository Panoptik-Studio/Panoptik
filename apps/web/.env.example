# Public frontend config — safe to expose (just a URL, not a secret).
# Set this in Vercel Project Settings → Environment Variables before building.
NEXT_PUBLIC_PANOPTIK_PROXY_URL=https://proxy.panoptik.app

# DO NOT put API keys here. Anything NEXT_PUBLIC_* ships in the browser bundle.
# Put GROQ_API_KEY, DEEPGRAM_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY,
# GEMINI_API_KEY, JWT_SECRET only in the Cloudflare Worker:
#   wrangler secret put GROQ_API_KEY
#   (etc. — see proxy/ directory)
